# Hosted Supabase Postgres — shared across the whole team's dev environment.
# Client/REST API credentials, used by the backend app and data/seed/seed_products.py.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Direct Postgres connection string for Supabase — used ONLY by
# data/scripts/apply_migrations.py to run schema migrations. Different from
# SUPABASE_URL/SUPABASE_KEY above (see that script's docstring for why).
SUPABASE_DB_URL=postgresql://postgres:your_password@your-project.supabase.co:5432/postgres

# Gemma 4 (Google AI Studio)
GEMMA_API_KEY=your_gemma_api_key

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# URLs (used for CORS + the frontend's API base URL)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Logging
LOG_LEVEL=INFO
LLM_LOGGING=true
