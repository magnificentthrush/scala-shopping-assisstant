# Hosted Supabase Postgres — shared across the whole team's dev environment.
# Client/REST API credentials, used by the backend app and data/seed/seed_products.py.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=
JWT_SECRET=

# Resend — auth verification emails from the verified domain scalainterns.dev.
# When RESEND_API_KEY is set, register sends a real email; otherwise the API
# returns verificationToken for a localStorage fallback (see docs/authPlan.md).
RESEND_API_KEY=
EMAIL_FROM=noreply@scalainterns.dev

# Gemma 4 (Google AI Studio)
GEMMA_API_KEY=your_gemma_api_key

# Auth
JWT_EXPIRES_IN_HOURS=168

# URLs (used for CORS + the frontend's API base URL)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Logging
LOG_LEVEL=INFO
LLM_LOGGING=true
